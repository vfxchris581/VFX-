// Windows resources for HD.exe and hdc.exe (generated into the build folder by CMake).
#include <winver.h>

// GLFW looks for an icon resource named GLFW_ICON and uses it for the window.
GLFW_ICON ICON "@HD_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "vfxchris581"
      VALUE "FileDescription", "HD procedural 3D and VFX"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "HD"
      VALUE "LegalCopyright", "vfxchris581"
      VALUE "ProductName", "HD"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
